{
  "name": "drawboard",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=drawboard-frontend --filter=http-backend --filter=ws-backend",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start.ps1",
    "start:unix": "node ./scripts/start.mjs",
    "db:generate": "pnpm exec prisma generate --schema packages/db/prisma/schema.prisma",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  }
}
