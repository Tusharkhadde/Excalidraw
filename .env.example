# Copy to the paths below before running `pnpm start` or double-clicking start.cmd
#
# packages/db/.env          (required — Prisma)
# apps/http-backend/.env    (required — HTTP API)
# apps/ws-backend/.env      (optional — falls back to packages/db/.env)

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/drawboard?schema=public"
JWT_SECRET="change-me-in-production"

# Google OAuth (same Client ID on frontend + HTTP backend)
# Create an OAuth 2.0 Client ID (Web) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000 and your Vercel URL
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Optional overrides
# PORT=3001
# NEXT_PUBLIC_HTTP_BACKEND=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:8080
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
