# Copy to the paths below before running `pnpm start` or double-clicking start.cmd
#
# packages/db/.env          (required — Prisma)
# apps/http-backend/.env    (required — HTTP API)
# apps/ws-backend/.env      (optional — falls back to packages/db/.env)

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/drawboard?schema=public"
JWT_SECRET="change-me-in-production"

# Optional overrides
# PORT=3001
# NEXT_PUBLIC_HTTP_BACKEND=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:8080
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
